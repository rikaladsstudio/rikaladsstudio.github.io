---
import BlogPostCard from "../components/BlogPostCard.astro";
import { getReadingTimeInText } from "../scripts/utils/reading-time";

const allBlogPosts = Object.values(
    import.meta.glob("../pages/blog/*.md", { eager: true }),
);

const nonDraftPosts = allBlogPosts.filter(
    (post: any) => !post.frontmatter.draft,
);
---

<div id="blog-posts-container">
    <section id="blog-posts-toolbar">
        <div class="total">
            {nonDraftPosts.length} POST{nonDraftPosts.length !== 1 ? "S" : ""}
        </div>
    </section>
    <section id="blog-posts-section">
        <div class="grid">
            {
                nonDraftPosts.map((post: any) => (
                    <BlogPostCard
                        title={post.frontmatter.title}
                        url={post.url}
                        imageUrl={post.frontmatter.image.url}
                        category={post.frontmatter.categories}
                        datePublished={post.frontmatter.pubDate}
                        minutesToRead={async () =>
                            await getReadingTimeInText(
                                await post.compiledContent(),
                                "min read",
                            )
                        }
                    />
                ))
            }
        </div>
    </section>
</div>
